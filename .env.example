# ==============================================================================
# Oracle VM Manager - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your environment-specific values:
#   cp .env.example .env.local
# ==============================================================================

# Application Metadata & Security
NEXT_PUBLIC_APP_NAME="Oracle VM Manager"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Adapter Mode: "mock" (offline development) or "live" (real OCI Compute API)
VM_ADAPTER_MODE="mock"

# Initial Administrator Credentials
# Generate Argon2id hash via: npm run seed or node scripts/generate-argon2.js
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=1$..."

# 32+ byte cryptographic secret for HMAC-SHA256 CSRF signing & session entropy
# Generate via: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-secret"

# Database Configuration (PostgreSQL / Supabase Transaction Pooler)
# For Supabase Pooler: use port 6543 with ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Fallback: set to "true" to run with in-memory SQLite/fallback during local mock dev
ALLOW_IN_MEMORY_DB="false"

# ------------------------------------------------------------------------------
# Oracle Cloud Infrastructure (OCI) Configuration (Required only for live mode)
# ------------------------------------------------------------------------------
# Target Region (e.g. us-phoenix-1, us-ashburn-1, ap-mumbai-1)
OCI_REGION="us-phoenix-1"

# Target Compute Instance OCID
OCI_INSTANCE_OCID="ocid1.instance.oc1.phx.exampleuniqueid"
OCI_INSTANCE_DISPLAY_NAME="my-production-vm"

# OCI IAM Tenancy and User OCIDs
OCI_TENANCY_OCID="ocid1.tenancy.oc1..exampletenancyocid"
OCI_COMPARTMENT_OCID="ocid1.compartment.oc1..examplecompartmentocid"
OCI_USER_OCID="ocid1.user.oc1..exampleuserocid"

# API Key Fingerprint and Private Key
# OCI_PRIVATE_KEY can be either a full file path (C:/keys/oci_api_key.pem) or inline PEM content
OCI_FINGERPRINT="20:3b:97:13:55:1c:..."
OCI_PRIVATE_KEY="/path/to/oci_api_key.pem"
# OCI_PRIVATE_KEY_PASSPHRASE="" # Optional: only if your PEM key is password encrypted
